# /etc/house-power/sampler.env — lives ON THE PI ONLY, never in git.
# RANGE_AMPS must match the physical jumper on BOTH clamps (100/150/200).
RANGE_AMPS=100
# Backend / broker location (IP or hostname on your LAN).
MQTT_HOST=192.168.1.6
MQTT_PORT=1883
MQTT_TOPIC=house/power/v1
# Optional HTTP fallback, e.g. http://192.168.1.6:8000/api/v1/readings
HTTP_URL=
PUBLISH_HZ=1
# ADC_DRATE=0x82  # 100 SPS default; see ADS1256_DRATE_E for options
# LEG1_CHANNELS=0,2,4,6
# LEG2_CHANNELS=1,3,5,7
